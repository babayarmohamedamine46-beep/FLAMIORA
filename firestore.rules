rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The store owner account used by the FLAMIORA admin panel.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'babayarmohamedamine4@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Public storefront may submit a COD order.
      allow create: if
        request.resource.data.status == 'pending'
        && request.resource.data.customer_name is string
        && request.resource.data.customer_phone is string
        && request.resource.data.city_id is string
        && request.resource.data.address is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number;

      // Only the store owner can view or manage customer orders.
      allow read, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}

