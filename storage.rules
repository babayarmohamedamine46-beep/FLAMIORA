rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'babayarmohamedamine4@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function underSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /hero/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underSizeLimit();
    }
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underSizeLimit();
    }
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underSizeLimit();
    }
  }
}
